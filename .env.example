APP_ENV=development
APP_NAME=Infra Incident AI
API_HOST=0.0.0.0
API_PORT=8080
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8088

# Optional local AI. The deterministic fallback works without Ollama.
ENABLE_OLLAMA=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:35b
OLLAMA_TIMEOUT_SECONDS=20

# Future adapters. Leave empty in the standalone demo.
CALLCENTER_BASE_URL=
CALLCENTER_API_TOKEN=
KENCE_BASE_URL=
KENCE_API_TOKEN=
KENCE_SESSION_ID=
KENCE_TIMEOUT_SECONDS=30
